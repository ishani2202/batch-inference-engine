# Copy to .env and fill in. Only MODEL_ACCESS_KEY is required.

# DigitalOcean Serverless Inference (OpenAI-compatible)
MODEL_ACCESS_KEY=
INFERENCE_URL=https://inference.do-ai.run/v1
MODEL=mistral-3-14B
MAX_TOKENS=128

# Concurrency (adaptive between MIN and MAX; MAX is also the worker count)
MAX_CONCURRENCY=32
MIN_CONCURRENCY=1
START_CONCURRENCY=8
QUEUE_SIZE=100

# Retries
MAX_RETRIES=6
MAX_RATE_LIMIT_RETRIES=20
REQUEST_TIMEOUT=60

# Cost estimate, USD per 1M tokens (DigitalOcean pricing for mistral-3-14B; change with MODEL)
PRICE_INPUT_PER_M=0.20
PRICE_OUTPUT_PER_M=0.20

# Optional: DigitalOcean Spaces progressive upload
SPACES_BUCKET=
SPACES_REGION=nyc3
SPACES_KEY=
SPACES_SECRET=
SPACES_PART_SIZE=500
